# Copy this file to .env and replace values for the target environment.
# Values here are delivered to browsers; do not put secrets in this file.
API_BASE_URL=https://your-backend.example.com/api
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_IDENTITY_SERVICES_URL=https://your-google-identity-services-url.example.com/client
APP_NAME=Stack Portal
ENVIRONMENT_NAME=development
ENABLE_GOOGLE_SIGN_IN=true
